# Secrets uniquement. Aucun réglage fonctionnel ici : seuils, identifiants de
# rôles et de salons, délais et textes vivent dans config/*.yml.
#
# Copier ce fichier en .env et renseigner les valeurs. Le démarrage est refusé
# si l'une de ces clés est absente ou vide.

# Jeton de l'application Discord — portail développeur, onglet Bot.
DISCORD_TOKEN=

# Identifiant de l'application Discord — portail développeur, General Information.
DISCORD_CLIENT_ID=

# production | development
# En development, les journaux sont aussi écrits sur la console.
NODE_ENV=
